# Copy to .env.mongo and set real passwords: cp .env.mongo.example .env.mongo
# Used by the mongodb service in compose.yaml.

# Root (admin) user, created by the mongo image on first start
MONGO_INITDB_ROOT_USERNAME=resqplate_admin
MONGO_INITDB_ROOT_PASSWORD=change-me-root-password

# App database and user, created by mongo-init/01-create-app-user.js on first start
MONGO_INITDB_DATABASE=resqplate
MONGO_APP_USERNAME=resqplate_app
# Must match the password in MONGO_URI in .env.container
MONGO_APP_PASSWORD=change-me-app-password
