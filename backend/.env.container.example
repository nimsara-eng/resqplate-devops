# Copy to .env.container: cp .env.container.example .env.container
# Used by the backend service in compose.yaml.

PORT=5000

# User, password and database must match MONGO_APP_* / MONGO_INITDB_DATABASE in .env.mongo.
# Host is the mongodb network alias from compose.yaml.
# If the password has special characters (@ : / ? # %), URL-encode them.
MONGO_URI=mongodb://resqplate_app:change-me-app-password@resqplate-mongodb:27017/resqplate
